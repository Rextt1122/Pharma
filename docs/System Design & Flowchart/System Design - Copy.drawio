<mxfile host="app.diagrams.net" agent="Hermes">
  <diagram id="pharma-iot-simple" name="Alur System Design">
    <mxGraphModel dx="1694" dy="959" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;" value="ALUR SYSTEM DESIGN GUDANG FARMASI &amp;amp; STERILISASI SINAR UV-C" vertex="1">
          <mxGeometry height="30" width="740" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1E293B;align=left;spacingLeft=14;" value="&lt;b&gt;NODE 1: RAK PENYIMPANAN (ESP32)&lt;/b&gt;&lt;br&gt;• Sensor Suhu &amp;amp; Lembap (DHT22), Gas (MQ-2)&lt;br&gt;• Relay Kipas &amp;amp; Buzzer Alarm" vertex="1">
          <mxGeometry height="95" width="340" x="31" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1E293B;align=left;spacingLeft=14;" value="&lt;b&gt;NODE 2: KEAMANAN &amp;amp; SINAR UV-C (ESP32)&lt;/b&gt;&lt;br&gt;• Sensor Pintu (Reed Switch) &amp;amp; Gerak (PIR)&lt;br&gt;• Relay Sinar UV-C (Auto mati jika ada orang yang masuk)" vertex="1">
          <mxGeometry height="95" width="340" x="520" y="90" as="geometry" />
        </mxCell>
        <mxCell id="docker_env" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;dashed=1;fontSize=13;fontColor=#0369A1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;arcSize=8;" value="&lt;b&gt;SERVER VM — LINGKUNGAN CONTAINER DOCKER (VIRTUALBOX)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0284C7&quot;&gt;• Layanan server berjalan terisolasi di dalam Docker: pbl_mqtt, pbl_backend, pbl_database&lt;/font&gt;" vertex="1">
          <mxGeometry height="340" width="870" x="25" y="240" as="geometry" />
        </mxCell>
        <mxCell id="mqtt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontSize=13;fontColor=#1E293B;" value="&lt;b&gt;BROKER MQTT (MOSQUITTO)&lt;/b&gt; — &lt;font color=&quot;#0369A1&quot;&gt;[Container: pbl_mqtt]&lt;/font&gt;&amp;nbsp;&lt;font color=&quot;#B45309&quot;&gt;(Rencana Integrasi)&lt;/font&gt;&lt;br&gt;Jembatan Publish / Subscribe untuk pengiriman data sensor &amp;amp; perintah tombol aktuator" vertex="1">
          <mxGeometry height="75" width="540" x="170" y="300" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;fontColor=#1E293B;" value="&lt;b&gt;BACKEND REST API (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0369A1&quot;&gt;[Container: pbl_backend]&lt;/font&gt;&amp;nbsp;&lt;font color=&quot;#15803D&quot;&gt;[Aktif]&lt;/font&gt;&lt;br&gt;Autentikasi Login, Role &amp;amp; Riwayat Sensor" vertex="1">
          <mxGeometry height="80" width="240" x="320" y="460" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=12;fontColor=#1E293B;" value="&lt;b&gt;DATABASE (MySQL)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0369A1&quot;&gt;[Container: pbl_database]&lt;/font&gt;&lt;br&gt;Tabel User &amp;amp; Log Sensor" vertex="1">
          <mxGeometry height="90" width="180" x="690" y="455" as="geometry" />
        </mxCell>
        <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#1E293B;" value="&lt;b&gt;APLIKASI MOBILE ANDROID (FLUTTER)&lt;/b&gt;&amp;nbsp;&lt;div&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;[Aktif]&lt;/font&gt;&lt;br&gt;Dashboard Suhu &amp;amp; Pintu • Grafik • Riwayat &amp;amp; Export CSV • Tombol Kontrol UV-C &amp;amp; Alarm&lt;/div&gt;" vertex="1">
