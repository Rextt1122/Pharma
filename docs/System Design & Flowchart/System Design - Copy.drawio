        <mxCell id="e3" edge="1" parent="1" source="mqtt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;startArrow=none;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;" target="api" value="2. Kirim data sensor ke Backend (Rencana)">
